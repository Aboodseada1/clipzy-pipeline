# Database
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/clipzy?schema=public"

# NextAuth — generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-32-byte-hex-secret"
AUTH_URL="https://clipzy.aaseada.com"
NEXTAUTH_URL="https://clipzy.aaseada.com"

# App
NEXT_PUBLIC_APP_NAME="Clipzy"
NEXT_PUBLIC_APP_URL="https://clipzy.aaseada.com"

# Initial seeded operator
SEED_OPERATOR_EMAIL="ops@clipzy.aaseada.com"
SEED_OPERATOR_PASSWORD="change-me"
